    <txttips>
        <txttip left="87" top="6" right="559" bottom="101" content="LAYER 2 OFF-PATH NETWWORKING DESIGN&#x0D;&#x0A;1.Inline L.2 design means the AC seats inline the data path&#x0D;&#x0A;2.bypass l.2 design occour when the AC seats by pass the data&#x0D;&#x0A;flow but it is within the same subnet&#x0D;&#x0A;&#x0D;&#x0A;for this topology is the bypass L.2 design" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
